# AreYouLowBattery - Hardened UDev rules for wireless mice, keyboards and headsets
# Security Architecture:
# 1. Vendor Isolation: Strictly scoped to recognized peripheral vendor IDs (ATTRS{idVendor}).
# 2. Anti-Keylogger Hardening: Explicitly excludes standard Boot Keyboard interfaces (ATTRS{bInterfaceProtocol}!="01").
#    The physical text typing endpoints remain strictly locked to root:root (0600), ensuring malicious
#    processes cannot intercept keystrokes via hidraw, while vendor telemetry endpoints (bInterfaceProtocol!="01")
#    receive access for battery monitoring.
# 3. Dynamic Seat Access: Uses TAG+="uaccess" with MODE="0660" so systemd-logind grants dynamic ACL access
#    exclusively to the active physical console session user, never world-writable (0666).

# Delux / Attack Shark / Xenta / CompX / Beken devices (VID: 0x1d57)
ACTION!="remove", KERNEL=="hidraw*", SUBSYSTEM=="hidraw", ATTRS{bInterfaceProtocol}!="01", ATTRS{idVendor}=="1d57", MODE="0660", TAG+="uaccess"

# Areson / CompX 2.4G Dual Mode mice & keyboards (Ajazz, Attack Shark, Pulsar, Lamzu, VXE, Royalaxe) (VID: 0x25a7)
ACTION!="remove", KERNEL=="hidraw*", SUBSYSTEM=="hidraw", ATTRS{bInterfaceProtocol}!="01", ATTRS{idVendor}=="25a7", MODE="0660", TAG+="uaccess"

# Royuan / RongYuan / Royalaxe / Akko / MonsGeek keyboards (VID: 0x3151)
ACTION!="remove", KERNEL=="hidraw*", SUBSYSTEM=="hidraw", ATTRS{bInterfaceProtocol}!="01", ATTRS{idVendor}=="3151", MODE="0660", TAG+="uaccess"

# Actions Semiconductor Co., Ltd USB Audio & HID dongles (Baseus GH02, etc.) (VID: 0x10d6)
ACTION!="remove", KERNEL=="hidraw*", SUBSYSTEM=="hidraw", ATTRS{bInterfaceProtocol}!="01", ATTRS{idVendor}=="10d6", MODE="0660", TAG+="uaccess"

# SinoWealth generic gaming devices (VID: 0x258a)
ACTION!="remove", KERNEL=="hidraw*", SUBSYSTEM=="hidraw", ATTRS{bInterfaceProtocol}!="01", ATTRS{idVendor}=="258a", MODE="0660", TAG+="uaccess"

