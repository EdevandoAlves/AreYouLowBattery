ACTION!="remove", KERNEL=="hidraw*", SUBSYSTEM=="hidraw", ATTRS{bInterfaceProtocol}!="01", ATTRS{idVendor}=="248a", MODE="0660", TAG+="uaccess"
ACTION!="remove", KERNEL=="hidraw*", SUBSYSTEM=="hidraw", ATTRS{bInterfaceProtocol}!="01", ATTRS{idVendor}=="1915", MODE="0660", TAG+="uaccess"
ACTION!="remove", KERNEL=="hidraw*", SUBSYSTEM=="hidraw", ATTRS{bInterfaceProtocol}!="01", ATTRS{idVendor}=="3554", MODE="0660", TAG+="uaccess"

